            "dataType": "sc:Integer",
            "source": {
              "fileObject": { "@id": "collisions-csv" },
              "extract": { "column": "second_road_class" }
            }
          },
          {
            "@type": "cr:Field",
            "@id": "collisions/second_road_number",
            "description": "Road number of the second road involved in the collision.",
            "dataType": "sc:Integer",
            "source": {
              "fileObject": { "@id": "collisions-csv" },
              "extract": { "column": "second_road_number" }
            }
          },
          {
            "@type": "cr:Field",
            "@id": "collisions/pedestrian_crossing_human_control_historic",
            "description": "Historic coding for human-controlled pedestrian crossing (pre-2016 STATS19 schema).",
            "dataType": "sc:Integer",
            "source": {
              "fileObject": { "@id": "collisions-csv" },
              "extract": { "column": "pedestrian_crossing_human_control_historic" }
            }
          },
          {
            "@type": "cr:Field",
            "@id": "collisions/pedestrian_crossing_physical_facilities_historic",
            "description": "Historic coding for physical pedestrian crossing facilities (pre-2016 STATS19 schema).",
            "dataType": "sc:Integer",
            "source": {
              "fileObject": { "@id": "collisions-csv" },
              "extract": { "column": "pedestrian_crossing_physical_facilities_historic" }
            }
          },
          {
            "@type": "cr:Field",
            "@id": "collisions/pedestrian_crossing",
            "description": "Selected feature for ML pipeline. Presence and type of pedestrian crossing facilities at the collision site.",
            "dataType": "sc:Integer",
            "source": {
              "fileObject": { "@id": "collisions-csv" },
              "extract": { "column": "pedestrian_crossing" }
            }
          },
          {
            "@type": "cr:Field",
            "@id": "collisions/light_conditions",
            "description": "Selected feature for ML pipeline. Lighting conditions at the time of the collision (e.g. daylight, darkness with street lighting).",
            "dataType": "sc:Integer",
            "source": {
              "fileObject": { "@id": "collisions-csv" },
