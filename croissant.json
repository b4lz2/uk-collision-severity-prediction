    "@type": "sc:Dataset",
    "dct:conformsTo": "http://mlcommons.org/croissant/1.0",
    "name": "Road Safety Data – Collisions (Last 5 Years)",
    "description": "Police-reported road traffic collision records for Great Britain covering 2019–2023, collected via the STATS19 reporting system and published by the UK Department for Transport. The dataset contains 503,475 records with 44 attributes per collision. In this experiment, 15 features and 1 target label (collision_severity) are used to train supervised ML models to classify collision severity as Fatal, Serious, or Slight.",
    "citeAs": "@misc{dft2025roadsafety, title={Road Safety Data – Collisions (Last 5 Years)}, author={{Department for Transport, UK Government}}, year={2025}, howpublished={\\url{https://www.gov.uk/government/statistical-data-sets/road-safety-open-data}}, note={Open Government Licence v3.0. Collected via STATS19 police reporting system. First published September 2025, revised November 2025. Accessed March 2026.}}",
    "license": "https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/",
    "url": "https://www.gov.uk/government/statistical-data-sets/road-safety-open-data",
    "version": "1.0.0",
    "inLanguage": "en",
    "datePublished": "2025-09-01",
    "dateModified": "2025-11-01",
    "creator": {
      "@type": "sc:Person",
      "name": "Yehea El Dib",
      "identifier": "https://orcid.org/0009-0003-8506-0271"
    },
    "publisher": {
      "@type": "sc:Organization",
      "name": "UK Department for Transport",
      "url": "https://www.gov.uk/government/organisations/department-for-transport"
    },
    "keywords": [
      "road safety",
      "traffic collisions",
      "accident severity",
      "Great Britain",
      "STATS19",
      "open government data",
      "machine learning",
      "classification"
    ],
    "distribution": [
      {
        "@type": "cr:FileObject",
        "@id": "collisions-csv",
        "name": "dft-road-casualty-statistics-collision-last-5-years.csv",
        "description": "Single CSV file containing all 503,475 police-reported road collision records for Great Britain from 2019 to 2023, with 44 attributes per record.",
        "contentUrl": "https://data.dft.gov.uk/road-accidents-safety-data/dft-road-casualty-statistics-collision-last-5-years.csv",
        "encodingFormat": "text/csv"
      }
    ],
    "recordSet": [
      {
        "@type": "cr:RecordSet",
        "@id": "severity-enum",
        "description": "Enumeration of the three possible collision severity labels used as the target variable.",
        "dataType": "sc:Enumeration",
        "key": { "@id": "severity-enum/code" },
        "field": [
          {
            "@type": "cr:Field",
            "@id": "severity-enum/code",
            "description": "Numeric code for collision severity as stored in the raw dataset.",
            "dataType": "sc:Integer"
          },
          {
            "@type": "cr:Field",
            "@id": "severity-enum/label",
            "description": "Human-readable severity label.",
            "dataType": "sc:Text"
          }
        ],
        "data": [
          { "severity-enum/code": 1, "severity-enum/label": "Fatal" },
          { "severity-enum/code": 2, "severity-enum/label": "Serious" },
          { "severity-enum/code": 3, "severity-enum/label": "Slight" }
        ]
      },
      {
        "@type": "cr:RecordSet",
        "@id": "splits",
        "description": "Train / validation / test splits applied in the ML experiment (70% / 15% / 15%, stratified by collision_severity).",
        "dataType": "cr:Split",
        "key": { "@id": "splits/name" },
        "field": [
          {
            "@type": "cr:Field",
            "@id": "splits/name",
            "dataType": "sc:Text"
          },
          {
            "@type": "cr:Field",
            "@id": "splits/url",
            "dataType": "cr:Split"
          }
        ],
        "data": [
          { "splits/name": "train",      "splits/url": "cr:TrainingSplit" },
          { "splits/name": "validation", "splits/url": "cr:ValidationSplit" },
          { "splits/name": "test",       "splits/url": "cr:TestSplit" }
        ]
      },
      {
        "@type": "cr:RecordSet",
        "@id": "collisions",
        "description": "All 44 columns of the raw STATS19 collisions CSV. The 15 features selected for the ML pipeline are annotated with 'Selected feature for ML pipeline' in their descriptions; the target label is annotated with 'Target label for ML pipeline'.",
        "key": { "@id": "collisions/collision_index" },
        "field": [
          {
            "@type": "cr:Field",
            "@id": "collisions/collision_index",
            "description": "Unique identifier for each collision record.",
            "dataType": "sc:Text",
            "source": {
              "fileObject": { "@id": "collisions-csv" },
              "extract": { "column": "collision_index" }
            }
          },
          {
            "@type": "cr:Field",
            "@id": "collisions/collision_year",
            "description": "Calendar year in which the collision occurred.",
            "dataType": [
              "sc:Integer",
              "https://qudt.org/vocab/unit/YR"
            ],
            "source": {
              "fileObject": { "@id": "collisions-csv" },
              "extract": { "column": "collision_year" }
            }
          },
          {
            "@type": "cr:Field",
            "@id": "collisions/collision_ref_no",
            "description": "Police force reference number for the collision.",
            "dataType": "sc:Text",
            "source": {
              "fileObject": { "@id": "collisions-csv" },
              "extract": { "column": "collision_ref_no" }
            }
          },
          {
            "@type": "cr:Field",
            "@id": "collisions/location_easting_osgr",
            "description": "British National Grid easting coordinate of the collision location.",
            "dataType": [
              "sc:Float",
              "https://si-digital-framework.org/SI/units/metre"
            ],
            "source": {
              "fileObject": { "@id": "collisions-csv" },
              "extract": { "column": "location_easting_osgr" }
            }
          },
          {
            "@type": "cr:Field",
            "@id": "collisions/location_northing_osgr",
            "description": "British National Grid northing coordinate of the collision location.",
            "dataType": [
              "sc:Float",
              "https://si-digital-framework.org/SI/units/metre"
            ],
            "source": {
              "fileObject": { "@id": "collisions-csv" },
              "extract": { "column": "location_northing_osgr" }
            }
          },
          {
            "@type": "cr:Field",
            "@id": "collisions/longitude",
            "description": "WGS84 longitude of the collision location in decimal degrees.",
            "dataType": [
              "sc:Float",
              "https://si-digital-framework.org/SI/units/degree"
            ],
            "source": {
              "fileObject": { "@id": "collisions-csv" },
              "extract": { "column": "longitude" }
            }
          },
          {
            "@type": "cr:Field",
            "@id": "collisions/latitude",
            "description": "WGS84 latitude of the collision location in decimal degrees.",
            "dataType": [
              "sc:Float",
              "https://si-digital-framework.org/SI/units/degree"
            ],
            "source": {
              "fileObject": { "@id": "collisions-csv" },
              "extract": { "column": "latitude" }
            }
          },
          {
            "@type": "cr:Field",
            "@id": "collisions/police_force",
            "description": "Code identifying the police force that recorded the collision.",
            "dataType": "sc:Integer",
            "source": {
              "fileObject": { "@id": "collisions-csv" },
              "extract": { "column": "police_force" }
            }
          },
          {
            "@type": "cr:Field",
            "@id": "collisions/collision_severity",
            "description": "Target label for ML pipeline. Severity of the collision: 1=Fatal, 2=Serious, 3=Slight.",
            "dataType": [
              "sc:Integer",
              "cr:Label"
            ],
            "references": { "@id": "severity-enum/code" },
            "source": {
              "fileObject": { "@id": "collisions-csv" },
              "extract": { "column": "collision_severity" }
            }
          },
          {
            "@type": "cr:Field",
            "@id": "collisions/number_of_vehicles",
            "description": "Selected feature for ML pipeline. Number of vehicles involved in the collision.",
            "dataType": [
              "sc:Integer",
              "https://qudt.org/vocab/unit/NUM"
            ],
            "source": {
              "fileObject": { "@id": "collisions-csv" },
              "extract": { "column": "number_of_vehicles" }
            }
          },
          {
            "@type": "cr:Field",
            "@id": "collisions/number_of_casualties",
            "description": "Selected feature for ML pipeline. Number of casualties resulting from the collision.",
            "dataType": [
              "sc:Integer",
              "https://qudt.org/vocab/unit/NUM"
            ],
            "source": {
              "fileObject": { "@id": "collisions-csv" },
              "extract": { "column": "number_of_casualties" }
            }
          },
          {
            "@type": "cr:Field",
            "@id": "collisions/date",
            "description": "Date of the collision (DD/MM/YYYY).",
            "dataType": "sc:Date",
            "source": {
              "fileObject": { "@id": "collisions-csv" },
              "extract": { "column": "date" }
            }
          },
          {
            "@type": "cr:Field",
            "@id": "collisions/day_of_week",
            "description": "Selected feature for ML pipeline. Day of the week the collision occurred (1=Sunday, 2=Monday, …, 7=Saturday).",
            "dataType": "sc:Integer",
            "source": {
              "fileObject": { "@id": "collisions-csv" },
              "extract": { "column": "day_of_week" }
            }
          },
          {
            "@type": "cr:Field",
            "@id": "collisions/time",
            "description": "Time of the collision (HH:MM, 24-hour clock).",
            "dataType": "sc:Text",
            "source": {
              "fileObject": { "@id": "collisions-csv" },
              "extract": { "column": "time" }
            }
          },
          {
            "@type": "cr:Field",
            "@id": "collisions/local_authority_district",
            "description": "Code for the local authority district where the collision occurred.",
            "dataType": "sc:Integer",
            "source": {
              "fileObject": { "@id": "collisions-csv" },
              "extract": { "column": "local_authority_district" }
            }
          },
          {
            "@type": "cr:Field",
