      "@id": "collisions-csv",
      "name": "dft-road-casualty-statistics-collision-last-5-years.csv",
      "description": "Original raw CSV file published by the UK Department for Transport containing 503,475 collision records.",
      "contentUrl": "https://data.dft.gov.uk/road-accidents-safety-data/dft-road-casualty-statistics-collision-last-5-years.csv",
      "encodingFormat": "text/csv"
    },
    {
      "@type": "cr:FileObject",
      "@id": "dbrepo-view-api",
      "name": "collision_ml_features_view",
      "description": "Live REST API endpoint hosted on DBRepo (TuWien) used directly by the loading script to paginate unique records.",
      "contentUrl": "https://test.dbrepo.tuwien.ac.at/api/v1/database/82c19b39-246c-4409-b25c-8baf3a158a70/view/9fe5373a-0942-4b87-8794-0951506317cb/data",
      "encodingFormat": "application/json"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "severity-enum",
      "name": "severity-enum",
      "description": "Enumeration of the three possible collision severity labels used as the target variable.",
      "key": { "@id": "severity-enum/code" },
      "field": [
  {
    "@type": "cr:Field",
    "@id": "severity-enum/code",
    "name": "code",
    "description": "Numeric code for collision severity as stored in the dataset.",
    "dataType": "sc:Integer"
  },
  {
    "@type": "cr:Field",
    "@id": "severity-enum/label",
    "name": "label",
    "description": "Human-readable severity label.",
    "dataType": "sc:Text"
  }
],
"data": [
  { "code": 1, "label": "Fatal" },
  { "code": 2, "label": "Serious" },
  { "code": 3, "label": "Slight" }
]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "splits",
      "name": "splits",
      "description": "Train / validation / test splits applied in the ML experiment script (70% / 15% / 15%, stratified).",
      "key": { "@id": "splits/name" },
      "field": [
  {
    "@type": "cr:Field",
    "@id": "splits/name",
    "name": "name",
    "dataType": "sc:Text"
  },
  {
    "@type": "cr:Field",
    "@id": "splits/url",
    "name": "url",
    "dataType": "sc:Text"
  }
],
"data": [
  { "name": "train", "url": "cr:TrainingSplit" },
  { "name": "validation", "url": "cr:ValidationSplit" },
  { "name": "test", "url": "cr:TestSplit" }
]
    },
