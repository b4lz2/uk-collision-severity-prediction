            "dataType": "sc:Text",
            "source": {
              "fileObject": { "@id": "collisions-csv" },
              "extract": { "column": "local_authority_highway_current" }
            }
          },
          {
            "@type": "cr:Field",
            "@id": "collisions/first_road_class",
            "description": "Selected feature for ML pipeline. Classification of the first road involved (e.g. Motorway, A road, B road).",
            "dataType": "sc:Integer",
            "source": {
              "fileObject": { "@id": "collisions-csv" },
              "extract": { "column": "first_road_class" }
            }
          },
          {
            "@type": "cr:Field",
            "@id": "collisions/first_road_number",
            "description": "Road number of the first road involved.",
            "dataType": "sc:Integer",
            "source": {
              "fileObject": { "@id": "collisions-csv" },
              "extract": { "column": "first_road_number" }
            }
          },
          {
            "@type": "cr:Field",
            "@id": "collisions/road_type",
            "description": "Selected feature for ML pipeline. Type of road on which the collision occurred (e.g. single carriageway, dual carriageway, roundabout).",
            "dataType": "sc:Integer",
            "source": {
              "fileObject": { "@id": "collisions-csv" },
              "extract": { "column": "road_type" }
            }
          },
          {
            "@type": "cr:Field",
