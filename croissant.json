          {
            "@type": "cr:Field",
            "@id": "collisions/road_surface_conditions",
            "description": "Selected feature for ML pipeline. Condition of the road surface at the time of the collision (e.g. dry, wet, icy).",
            "dataType": "sc:Integer",
            "source": {
              "fileObject": { "@id": "collisions-csv" },
              "extract": { "column": "road_surface_conditions" }
            }
          },
          {
            "@type": "cr:Field",
            "@id": "collisions/special_conditions_at_site",
            "description": "Selected feature for ML pipeline. Any special conditions present at the site (e.g. road works, oil/diesel spillage).",
            "dataType": "sc:Integer",
            "source": {
              "fileObject": { "@id": "collisions-csv" },
