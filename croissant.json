            "dataType": [
              "sc:Integer",
              "https://qudt.org/vocab/unit/MI-PER-HR"
            ],
            "source": {
              "fileObject": { "@id": "collisions-csv" },
              "extract": { "column": "speed_limit" }
            }
          },
          {
            "@type": "cr:Field",
            "@id": "collisions/junction_detail_historic",
            "description": "Historic coding of junction detail (pre-2016 STATS19 schema).",
            "dataType": "sc:Integer",
            "source": {
              "fileObject": { "@id": "collisions-csv" },
              "extract": { "column": "junction_detail_historic" }
            }
          },
          {
            "@type": "cr:Field",
            "@id": "collisions/junction_detail",
            "description": "Selected feature for ML pipeline. Type of junction at or near the collision site (e.g. roundabout, T-junction, crossroads).",
            "dataType": "sc:Integer",
            "source": {
              "fileObject": { "@id": "collisions-csv" },
              "extract": { "column": "junction_detail" }
            }
          },
          {
            "@type": "cr:Field",
            "@id": "collisions/junction_control",
            "description": "Selected feature for ML pipeline. Type of traffic control at the junction (e.g. traffic signals, give way, stop sign).",
            "dataType": "sc:Integer",
            "source": {
              "fileObject": { "@id": "collisions-csv" },
              "extract": { "column": "junction_control" }
            }
          },
          {
            "@type": "cr:Field",
            "@id": "collisions/second_road_class",
